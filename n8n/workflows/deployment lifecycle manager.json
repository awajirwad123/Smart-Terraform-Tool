    {
      "parameters": {
        "jsCode": "const templates = $json[\"template_files\"];\n\nfunction escapeHTML(str) {\n  return str.replace(/&/g, \"&amp;\")\n            .replace(/</g, \"&lt;\")\n            .replace(/>/g, \"&gt;\");\n}\n\nlet html = `<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Terraform Template Files</title>\n</head>\n<body>\n  <h1>Terraform Template Files</h1>\n`;\n\nfor (const [filename, content] of Object.entries(templates)) {\n  html += `\n  <h2>${filename}</h2>\n  <pre><code>${escapeHTML(content)}</code></pre>\n`;\n}\n\nhtml += `\n</body>\n</html>\n`;\n\nreturn [{ json: { html } }];"
      },
